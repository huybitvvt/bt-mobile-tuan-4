{
  "expo": {
    "name": "Student Manager",
    "slug": "bt-mobile-tuan-4",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.huybitvvt.studentmanager",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.huybitvvt.studentmanager",
      "softwareKeyboardLayoutMode": "resize"
    },
    "locales": {
      "vi": "./locales/vi.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-localization", "./plugins/withLocalizedAppName",
      ["expo-image-picker", {
        "photosPermission": "Allow Student Manager to choose a student avatar from your photos.",
        "cameraPermission": false,
        "microphonePermission": false
      }]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
